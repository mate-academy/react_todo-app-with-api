export const App: React.FC = () => {
  const [data, setData] = useState<Todo[]>([]);
  const [newTodoTitle, setNewTodoTitle] = useState<string>('');
  const [isSubmitting, setIsSubmitting] = useState<boolean>(false);
  // Використовуємо Set для відстеження ID завдань, що обробляються
  const [processingTodoIds, setProcessingTodoIds] = useState<Set<number>>(new Set());
  // Локальні стани для редагування
  const [editingTodoId, setEditingTodoId] = useState<number | null>(null); // ID завдання, що редагується
  const [tempTitle, setTempTitle] = useState<string>(''); // Тимчасовий заголовок під час редагування

  const editInputRef = useRef<HTMLInputElement>(null); // Ref для поля вводу в режимі редагування

  const [filter, setFilter] = useState<FilterParams>(FilterParams.All);
  const [errorMessage, setErrorMessage] = useState<ErrorMessages>(
    ErrorMessages.None,
  );

  // Фокус на поле створення нового todo при завершенні submit або коли немає активних операцій
  useEffect(() => {
    if (!isSubmitting && processingTodoIds.size === 0) {
      const inputField = document.querySelector(
        '.todoapp__new-todo',
      ) as HTMLInputElement;

      if (inputField) {
        inputField.focus();
      }
    }
  }, [isSubmitting, processingTodoIds]);

  // Фокус на поле редагування при активації режиму редагування
  useEffect(() => {
    if (editingTodoId !== null && editInputRef.current) {
      editInputRef.current.focus();
    }
  }, [editingTodoId]);


  useEffect(() => {
    setErrorMessage(ErrorMessages.None);
    // Додаємо тимчасовий ID (0) до processingTodoIds для відображення глобального лоадера
    setProcessingTodoIds(prev => new Set(prev).add(0));

    getTodos()
      .then(setData)
      .catch(() => setErrorMessage(ErrorMessages.OnGet))
      .finally(() => {
        // Прибираємо тимчасовий ID (0) після завантаження
        setProcessingTodoIds(prev => {
          const newSet = new Set(prev);
          newSet.delete(0);
          return newSet;
        });
      });
  }, []);

  useEffect(() => {
    if (errorMessage !== ErrorMessages.None) {
      const timer = setTimeout(() => {
        setErrorMessage(ErrorMessages.None);
      }, 3000);

      return () => clearTimeout(timer);
    }
  }, [errorMessage]);

  const filteredTodos = data.filter(todo => {
    switch (filter) {
      case FilterParams.Active:
        return !todo.completed;
      case FilterParams.Completed:
        return todo.completed;
      default:
        return true;
    }
  });

  if (!USER_ID) {
    return <UserWarning />;
  }

  function createTodo() {
    if (newTodoTitle.trim() === '') {
      setErrorMessage(ErrorMessages.OnEmptyTitle);
      return;
    }

    const newTodoData = {
      userId: USER_ID,
      title: newTodoTitle.trim(),
      completed: false,
    };

    const tempTodo = {
      id: 0,
      userId: USER_ID,
      title: newTodoTitle.trim(),
      completed: false,
    };

    setData(currentTodos => [...currentTodos, tempTodo]);
    setNewTodoTitle('');
    setIsSubmitting(true);
    setProcessingTodoIds(prev => new Set(prev).add(0));

    postService.createTodo(newTodoData)
      .then(newTodo => {
        setData(currentTodos =>
          currentTodos.map(todo => (todo.id === 0 ? newTodo : todo)),
        );
      })
      .catch(() => {
        setData(currentTodos => currentTodos.filter(todo => todo.id !== 0));
        setErrorMessage(ErrorMessages.OnPost);
      })
      .finally(() => {
        setIsSubmitting(false);
        setProcessingTodoIds(prev => {
          const newSet = new Set(prev);
          newSet.delete(0);
          return newSet;
        });
      });
  }

  function updateTodo(todoToUpdate: Todo) {
    setProcessingTodoIds(prev => new Set(prev).add(todoToUpdate.id));

    postService
      .updateTodo(todoToUpdate)
      .then(updatedTodo => {
        setData(currentTodos =>
          currentTodos.map(existingTodo =>
            existingTodo.id === updatedTodo.id ? updatedTodo : existingTodo,
          ),
        );
        setErrorMessage(ErrorMessages.None);
      })
      .catch(() => {
        setErrorMessage(ErrorMessages.OnUpdate);
      })
      .finally(() => {
        setProcessingTodoIds(prev => {
          const newSet = new Set(prev);
          newSet.delete(todoToUpdate.id);
          return newSet;
        });
        setEditingTodoId(null);
        setTempTitle('');
      });
  }

  function deleteCompletedTodos() {
    const completedTodos = data.filter(todo => todo.completed);

    if (completedTodos.length === 0) {
      return;
    }

    setProcessingTodoIds(prev => new Set([...prev, ...completedTodos.map(t => t.id)]));

    const deletePromises = completedTodos.map(todo =>
      postService.deleteTodo(todo.id).then(() => todo.id),
    );

    Promise.allSettled(deletePromises)
      .then(results => {
        const successIds = results
          .filter(result => result.status === 'fulfilled')
          .map(result => (result as PromiseFulfilledResult<number>).value);

        const isSomeFailed = results.some(
          result => result.status === 'rejected',
        );

        if (isSomeFailed) {
          setErrorMessage(ErrorMessages.OnDelete);
          getTodos().then(setData);
        } else {
          setData(currentTodos =>
            currentTodos.filter(todo => !successIds.includes(todo.id)),
          );
        }
      })
      .catch(() => {
        setErrorMessage(ErrorMessages.OnDelete);
        getTodos().then(setData);
      })
      .finally(() => {
        setProcessingTodoIds(prev => {
          const newSet = new Set(prev);
          completedTodos.forEach(todo => newSet.delete(todo.id));
          return newSet;
        });
      });
  }

  function deleteTodo(id: number) {
    setProcessingTodoIds(prev => new Set(prev).add(id));

    postService
      .deleteTodo(id)
      .then(() => {
        setData(currentTodos => currentTodos.filter(todo => todo.id !== id));
      })
      .catch(() => {
        setErrorMessage(ErrorMessages.OnDelete);
      })
      .finally(() => {
        setProcessingTodoIds(prev => {
          const newSet = new Set(prev);
          newSet.delete(id);
          return newSet;
        });
      });
  }

  function handleToggle(id: number, completed: boolean) {
    setData(currentTodos =>
      currentTodos.map(todo =>
        todo.id === id ? { ...todo, completed: !completed } : todo,
      ),
    );
    updateTodo({ id, completed: !completed, userId: USER_ID, title: data.find(t => t.id === id)?.title || '' });
  }

  const toggleAllTodos = () => {
    const allCompleted = data.every(todo => todo.completed);
    const todosToUpdate = data.filter(todo => todo.completed === allCompleted);

    setProcessingTodoIds(prev => new Set([...prev, ...todosToUpdate.map(t => t.id)]));

    const updatePromises = todosToUpdate.map(todo =>
      postService.updateTodo({ ...todo, completed: !allCompleted })
        .then(() => todo.id)
        .catch(error => {
          console.error(`Failed to update todo ${todo.id}:`, error);
          return { id: todo.id, status: 'rejected' };
        })
    );

    Promise.allSettled(updatePromises)
      .then(results => {
        const successIds = results
          .filter(result => result.status === 'fulfilled')
          .map(result => (result as PromiseFulfilledResult<number>).value);

        const isSomeFailed = results.some(
          result => result.status === 'rejected',
        );

        if (isSomeFailed) {
          setErrorMessage(ErrorMessages.OnUpdate);
          getTodos().then(setData);
        } else {
          setData(currentTodos =>
            currentTodos.map(todo =>
              successIds.includes(todo.id) ? { ...todo, completed: !allCompleted } : todo
            )
          );
        }
      })
      .catch(() => {
        setErrorMessage(ErrorMessages.OnUpdate);
        getTodos().then(setData);
      })
      .finally(() => {
        setProcessingTodoIds(prev => {
          const newSet = new Set(prev);
          todosToUpdate.forEach(todo => newSet.delete(todo.id));
          return newSet;
        });
      });
  };

  const handleKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
    const isEnterKey = e.key === 'Enter';

    if (isEnterKey) {
      e.preventDefault();
      createTodo();
    }
  };

  const handleEdit = (todo: Todo) => {
    if (processingTodoIds.has(todo.id)) { // Не дозволяємо редагувати, якщо todo обробляється
      return;
    }
    setEditingTodoId(todo.id);
    setTempTitle(todo.title);
  };

  const handleEditSubmit = (todo: Todo) => {
    const trimmedTempTitle = tempTitle.trim();

    if (trimmedTempTitle === todo.title) {
      setEditingTodoId(null);
      setTempTitle('');
      return;
    }

    if (trimmedTempTitle === '') {
      deleteTodo(todo.id);
      setEditingTodoId(null);
      setTempTitle('');
      return;
    }

    updateTodo({ ...todo, title: trimmedTempTitle });
  };

  return (
    <div className="todoapp">
      <h1 className="todoapp__title">todos</h1>

      <div className="todoapp__content">
        <header className="todoapp__header">
          {data.length > 0 && (
            <button
              type="button"
              className={classNames('todoapp__toggle-all', {
                active: data.every(todo => todo.completed),
              })}
              data-cy="ToggleAllButton"
              aria-label="Toggle all todos"
              onClick={toggleAllTodos}
            />
          )}

          <input
            data-cy="NewTodoField"
            type="text"
            className="todoapp__new-todo"
            placeholder="What needs to be done?"
            value={newTodoTitle}
            onChange={e => setNewTodoTitle(e.target.value)}
            onKeyDown={handleKeyDown}
            disabled={isSubmitting || processingTodoIds.has(0)}
          />
        </header>

        {(data.length > 0 || processingTodoIds.has(0)) && (
          <section className="todoapp__main" data-cy="TodoList">
            {processingTodoIds.has(0) && data.length === 0 && (
              <div data-cy="GlobalLoader" className="modal overlay is-active">
                <div className="modal-background has-background-white-ter" />
                <div className="loader" />
              </div>
            )}

            {filteredTodos.map(todo => {
              const isTodoBeingProcessed = processingTodoIds.has(todo.id);

              return (
                <div
                  data-cy="Todo"
                  className={classNames('todo', {
                    completed: todo.completed,
                    editing: todo.id === editingTodoId,
                  })}
                  key={todo.id}
                >
                  <label className="todo__status-label">
                    <input
                      data-cy="TodoStatus"
                      type="checkbox"
                      className="todo__status"
                      checked={todo.completed}
                      onChange={() => handleToggle(todo.id, todo.completed)}
                    />
                  </label>

                  {/* ПОПЕРЕДНІЙ ВАРІАНТ: Умовний рендеринг input або span */}
                  {todo.id === editingTodoId ? (
                    <input
                      data-cy="TodoTitleField"
                      type="text"
                      className="todo__title-field"
                      placeholder="Empty todo will be deleted"
                      value={tempTitle}
                      onChange={e => setTempTitle(e.target.value)}
                      onBlur={() => handleEditSubmit(todo)}
                      onKeyDown={e => {
                        if (e.key === 'Enter') {
                          handleEditSubmit(todo);
                        }
                        if (e.key === 'Escape') {
                          setEditingTodoId(null);
                          setTempTitle('');
                        }
                      }}
                      ref={editInputRef}
                      disabled={isTodoBeingProcessed}
                    />
                  ) : (
                    <span
                      data-cy="TodoTitle"
                      className="todo__title"
                      onDoubleClick={() => handleEdit(todo)}
                    >
                      {todo.title}
                    </span>
                  )}

                  <button
                    type="button"
                    className="todo__remove"
                    data-cy="TodoDelete"
                    onClick={() => deleteTodo(todo.id)}
                    disabled={isTodoBeingProcessed || isSubmitting}
                  >
                    ×
                  </button>

                  <div
                    data-cy="TodoLoader"
                    className={classNames('modal overlay', {
                      'is-active': isTodoBeingProcessed,
                    })}
                  >
                    <div className="modal-background has-background-white-ter" />
                    <div className="loader" />
                  </div>
                </div>
              );
            })}
             {isSubmitting && processingTodoIds.has(0) && (
              <div
                data-cy="Todo"
                className={classNames('todo', {
                  completed: false,
                })}
                key={0}
              >
                <label className="todo__status-label">
                  <input
                    data-cy="TodoStatus"
                    type="checkbox"
                    className="todo__status"
                    checked={false}
                    disabled
                  />
                </label>

                <span data-cy="TodoTitle" className="todo__title">
                  {newTodoTitle}
                </span>

                <div
                  data-cy="TodoLoader"
                  className={classNames('modal overlay', {
                    'is-active': processingTodoIds.has(0),
                  })}
                >
                  <div className="modal-background has-background-white-ter" />
                  <div className="loader" />
                </div>
              </div>
            )}
          </section>
        )}

        {(data.length > 0 || processingTodoIds.has(0)) && (
          <footer className="todoapp__footer" data-cy="Footer">
            <span className="todo-count" data-cy="TodosCounter">
              {data.filter(todo => !todo.completed).length}{' '}
              items left
            </span>

            <nav className="filter" data-cy="Filter">
              <a
                href="#/"
                className={classNames('filter__link', {
                  selected: filter === FilterParams.All,
                })}
                data-cy="FilterLinkAll"
                onClick={() => setFilter(FilterParams.All)}
              >
                All
              </a>

              <a
                href="#/active"
                className={classNames('filter__link', {
                  selected: filter === FilterParams.Active,
                })}
                data-cy="FilterLinkActive"
                onClick={() => setFilter(FilterParams.Active)}
              >
                Active
              </a>

              <a
                href="#/completed"
                className={classNames('filter__link', {
                  selected: filter === FilterParams.Completed,
                })}
                data-cy="FilterLinkCompleted"
                onClick={() => setFilter(FilterParams.Completed)}
              >
                Completed
              </a>
            </nav>

            <button
              type="button"
              className="todoapp__clear-completed"
              data-cy="ClearCompletedButton"
              disabled={data.filter(todo => todo.completed).length === 0 || processingTodoIds.size > 0}
              onClick={deleteCompletedTodos}
            >
              Clear completed
            </button>
          </footer>
        )}
      </div>

      <div
        data-cy="ErrorNotification"
        className={classNames(
          'notification',
          'is-danger',
          'is-light',
          'has-text-weight-normal',
          { hidden: errorMessage === ErrorMessages.None },
        )}
      >
        <button
          data-cy="HideErrorButton"
          type="button"
          className="delete"
          onClick={() => setErrorMessage(ErrorMessages.None)}
          aria-label="Hide error notification"
        />
        {errorMessage}
      </div>
    </div>
  );
};
