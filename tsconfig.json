{
  "extends": "@mate-academy/students-ts-config",
  "include": ["src", ".eslintrc.js"],
  "compilerOptions": {
    "sourceMap": false,
    "types": ["node", "cypress"],
    "target": "es5",
    "module": "commonjs",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
